                </imageView>
                <label opaque="NO" clipsSubviews="YES" userInteractionEnabled="NO" contentMode="left" fixedFrame="YES" text="Rules…" textAlignment="center" lineBreakMode="tailTruncation" minimumFontSize="10" translatesAutoresizingMaskIntoConstraints="NO" id="55">
                    <rect key="frame" x="256" y="55" width="175" height="82"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                    <fontDescription key="fontDescription" name="Zapfino" family="Zapfino" pointSize="24"/>
                    <color key="textColor" red="0.19758066534996033" green="0.19758066534996033" blue="0.19758066534996033" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    <color key="highlightedColor" red="1" green="1" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                </label>
                <label opaque="NO" clipsSubviews="YES" userInteractionEnabled="NO" contentMode="left" fixedFrame="YES" lineBreakMode="wordWrap" numberOfLines="24" baselineAdjustment="alignBaselines" minimumFontSize="10" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="47">
                    <rect key="frame" x="65" y="172" width="578" height="529"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                    <string key="text">Parlour Solitaire is Klondike —the most popular version of solitaire.The object is to move all the cards to the four foundations in the upper right of the layout.They must be placed on the foundations, grouped by suit, in order from Ace 
to King. You may move only the top-most card from the waste or from the 
tableau to the foundations (see diagram for an explanation of terms).Cards from the waste and tableau may be moved on top of cards in the 
tableau that are opposite in color and one rank higher. For example, a 
Red 6 may be moved and placed on top of a Black 7. When more than one 
card are ordered in this way in a tableau column it is called a family.Within the tableau, whole families may be moved onto other cards opposite
in color and one rank higher than the base of the family being moved.

When the top card in a column is face-down, it is turned face up.
Only a King may be placed in an empty tableau column.
Three or one card at a time are dealt from the stock pile to the waste. When 
the stock is empty, the waste may be returned to the stock and dealt again.</string>
                    <fontDescription key="fontDescription" name="SnellRoundhand-Bold" family="Snell Roundhand" pointSize="18"/>
                    <color key="textColor" red="0.19758066534996033" green="0.19758066534996033" blue="0.19758066534996033" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    <color key="highlightedColor" red="1" green="1" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    <size key="shadowOffset" width="0.0" height="0.0"/>
                </label>
                <label opaque="NO" clipsSubviews="YES" userInteractionEnabled="NO" contentMode="left" fixedFrame="YES" text="Parlour Solitaire Rules" lineBreakMode="tailTruncation" minimumFontSize="10" translatesAutoresizingMaskIntoConstraints="NO" id="45">
                    <rect key="frame" x="65" y="116" width="254" height="62"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                    <fontDescription key="fontDescription" name="SnellRoundhand-Bold" family="Snell Roundhand" pointSize="36"/>
                    <color key="textColor" red="0.19758066534996033" green="0.19758066534996033" blue="0.19758066534996033" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    <color key="highlightedColor" red="1" green="1" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                </label>
