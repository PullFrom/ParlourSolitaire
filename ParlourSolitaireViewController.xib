        <view opaque="NO" clearsContextBeforeDrawing="NO" contentMode="scaleToFill" id="40" userLabel="RulesView">
            <rect key="frame" x="0.0" y="0.0" width="708" height="750"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
            <subviews>
                <imageView userInteractionEnabled="NO" contentMode="TopLeft" fixedFrame="YES" image="Underline.png" translatesAutoresizingMaskIntoConstraints="NO" id="43">
                    <rect key="frame" x="273" y="104" width="148" height="10"/>
